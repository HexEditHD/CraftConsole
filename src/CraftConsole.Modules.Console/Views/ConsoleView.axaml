<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CraftConsole.Modules.Console.ViewModels"
             xmlns:models="using:CraftConsole.Core.Models"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             x:Class="CraftConsole.Modules.Console.Views.ConsoleView"
             x:DataType="vm:ConsoleViewModel">

    <Grid ColumnDefinitions="200,*">

        <!-- ══ Left sidebar ══════════════════════════════════════════════ -->
        <Border Grid.Column="0"
                Background="{DynamicResource HeaderBrush}"
                BorderBrush="{DynamicResource SeparatorBrush}"
                BorderThickness="0,0,1,0">
            <DockPanel>

                <!-- Sidebar header with player count -->
                <Border DockPanel.Dock="Top"
                        BorderBrush="{DynamicResource SeparatorBrush}"
                        BorderThickness="0,0,0,1"
                        Padding="12,10">
                    <TextBlock Text="{Binding ConnectedPlayerCount, StringFormat='PLAYERS  ·  {0}'}"
                               FontSize="10" FontWeight="SemiBold"
                               LetterSpacing="1.2"
                               Foreground="{DynamicResource TextMutedBrush}"/>
                </Border>

                <!-- Player list -->
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding ConnectedPlayers}"
                                  Margin="8,6"
                                  x:CompileBindings="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:PlayerAvatarItem">
                                <StackPanel Orientation="Horizontal"
                                            Spacing="8"
                                            Margin="0,3">
                                    <!-- Avatar: player head when loaded, letter circle as fallback -->
                                    <Panel Width="24" Height="24" VerticalAlignment="Center">
                                        <Border CornerRadius="4"
                                                Width="24" Height="24"
                                                Background="{Binding Username, Converter={StaticResource UsernameToColorConverter}}"
                                                IsVisible="{Binding Avatar, Converter={x:Static ObjectConverters.IsNull}}">
                                            <TextBlock Text="{Binding Username[0]}"
                                                       FontSize="11" FontWeight="Bold"
                                                       Foreground="White"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Border>
                                        <Image Source="{Binding Avatar}"
                                               Width="24" Height="24"
                                               IsVisible="{Binding Avatar, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                                    </Panel>
                                    <TextBlock Text="{Binding Username}"
                                               FontSize="12"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

            </DockPanel>
        </Border>

        <!-- ══ Right panel: toolbar + console output + input ════════════ -->
        <DockPanel Grid.Column="1">

            <!-- Toolbar -->
            <Border DockPanel.Dock="Top"
                    Background="{DynamicResource HeaderBrush}"
                    BorderBrush="{DynamicResource SeparatorBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="16,8">
                <Grid ColumnDefinitions="Auto,*,Auto">

                    <!-- Left: status dot + title -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Ellipse Width="6" Height="6"
                                 Fill="{Binding IsConnected, Converter={StaticResource BoolToStatusBrushConverter}}"
                                 VerticalAlignment="Center"/>
                        <TextBlock Text="Console"
                                   FontSize="14" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Right: Start / Stop / Clear / Auto-scroll -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <Button Content="▶"
                                Command="{Binding StartServerCommand}"
                                Theme="{StaticResource PrimaryButton}"
                                FontSize="11" Padding="10,4"
                                ToolTip.Tip="Start server"/>
                        <Button Content="■"
                                Command="{Binding StopServerCommand}"
                                Theme="{StaticResource DangerButton}"
                                FontSize="11" Padding="10,4"
                                ToolTip.Tip="Stop server"/>
                        <Button Content="⌫"
                                Command="{Binding ClearConsoleCommand}"
                                FontSize="11" Padding="10,4"
                                ToolTip.Tip="Clear output"/>
                        <Border Width="1" Background="{DynamicResource SeparatorBrush}" Margin="4,0"/>
                        <Button Content="↓"
                                Command="{Binding ToggleAutoScrollCommand}"
                                FontSize="11" Padding="10,4"
                                Opacity="{Binding AutoScroll, Converter={StaticResource BoolToOpacityConverter}}"
                                ToolTip.Tip="Auto-scroll to bottom"/>
                    </StackPanel>

                </Grid>
            </Border>

            <!-- Command input + suggestions -->
            <Border DockPanel.Dock="Bottom"
                    Background="{DynamicResource HeaderBrush}"
                    BorderBrush="{DynamicResource SeparatorBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="16,12"
                    IsEnabled="{Binding IsConnected}"
                    Opacity="{Binding IsConnected, Converter={StaticResource BoolToOpacityConverter}}">
                <DockPanel>
                    <!-- Autocomplete suggestions — sit above the input row -->
                    <Border x:Name="SuggestionsPanel"
                            DockPanel.Dock="Top"
                            IsVisible="{Binding ShowSuggestions}"
                            Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource AccentBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            MaxHeight="110"
                            Margin="0,0,80,8">
                        <ListBox x:Name="SuggestionList"
                                 ItemsSource="{Binding Suggestions}"
                                 Background="Transparent"
                                 SelectionChanged="OnSuggestionSelected"
                                 Padding="4">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}"
                                               FontFamily="Cascadia Code,Consolas,monospace"
                                               FontSize="12"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               Padding="6,3"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>

                    <!-- Input row -->
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBox x:Name="CommandBox"
                                 Grid.Column="0"
                                 Text="{Binding CommandInput}"
                                 Watermark="Enter command…"
                                 FontFamily="Cascadia Code,Consolas,monospace"
                                 FontSize="13"
                                 CornerRadius="8,0,0,8"
                                 KeyDown="OnInputKeyDown"/>
                        <Button Grid.Column="1"
                                Content="Send"
                                Command="{Binding SendCommandCommand}"
                                Theme="{StaticResource PrimaryButton}"
                                FontWeight="SemiBold"
                                CornerRadius="0,8,8,0"
                                Padding="18,9"/>
                    </Grid>
                </DockPanel>
            </Border>

            <!-- Console output -->
            <Panel>
                <ScrollViewer x:Name="ConsoleScroll"
                              Background="{DynamicResource BgBrush}"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto"
                              IsVisible="{Binding HasEntries}">
                    <ItemsControl ItemsSource="{Binding Entries}" Margin="16,12">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:ConsoleEntry">
                                <TextBlock Text="{Binding Raw}"
                                           FontFamily="Cascadia Code,Consolas,monospace"
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           Padding="0,1"
                                           Foreground="{Binding Level, Converter={StaticResource LevelToColorConverter}}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Empty state -->
                <StackPanel IsVisible="{Binding !HasEntries}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="8">
                    <TextBlock Text="No output yet"
                               FontSize="13"
                               Foreground="{DynamicResource TextMutedBrush}"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="Start a server to see console output here"
                               FontSize="11"
                               Foreground="{DynamicResource TextMutedBrush}"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Panel>

        </DockPanel>

    </Grid>
</UserControl>
