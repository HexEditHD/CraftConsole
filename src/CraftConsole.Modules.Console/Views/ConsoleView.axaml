<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CraftConsole.Modules.Console.ViewModels"
             xmlns:models="using:CraftConsole.Core.Models"
             xmlns:players="using:CraftConsole.Core.Players"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             x:Class="CraftConsole.Modules.Console.Views.ConsoleView"
             x:DataType="vm:ConsoleViewModel">

    <Grid ColumnDefinitions="180,*">

        <!-- ══ Left sidebar ══════════════════════════════════════════════ -->
        <Border Grid.Column="0"
                Background="{DynamicResource HeaderBrush}"
                BorderBrush="{DynamicResource SeparatorBrush}"
                BorderThickness="0,0,1,0">
            <DockPanel>

                <!-- Sidebar header -->
                <Border DockPanel.Dock="Top"
                        BorderBrush="{DynamicResource SeparatorBrush}"
                        BorderThickness="0,0,0,1"
                        Padding="12,10">
                    <TextBlock Text="PLAYERS"
                               FontSize="10" FontWeight="SemiBold"
                               LetterSpacing="1.2"
                               Foreground="{DynamicResource TextMutedBrush}"/>
                </Border>

                <!-- Quick-action buttons at bottom -->
                <StackPanel DockPanel.Dock="Bottom"
                            Margin="12,10"
                            Spacing="6">
                    <Button Content="Start"
                            Command="{Binding StartServerCommand}"
                            Theme="{StaticResource PrimaryButton}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            Padding="0,7"/>
                    <Button Content="Stop"
                            Command="{Binding StopServerCommand}"
                            Theme="{StaticResource DangerButton}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            Padding="0,7"/>
                    <Button Content="Clear"
                            Command="{Binding ClearConsoleCommand}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            Padding="0,7"/>
                </StackPanel>

                <!-- Player list -->
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding ConnectedPlayers}"
                                  Margin="8,6"
                                  x:CompileBindings="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="players:Player">
                                <StackPanel Orientation="Horizontal"
                                            Spacing="8"
                                            Margin="0,3">
                                    <!-- Avatar circle -->
                                    <Border CornerRadius="12"
                                            Width="24" Height="24"
                                            Background="{Binding Username, Converter={StaticResource UsernameToColorConverter}}"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Username[0]}"
                                                   FontSize="11" FontWeight="Bold"
                                                   Foreground="White"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="{Binding Username}"
                                               FontSize="12"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

            </DockPanel>
        </Border>

        <!-- ══ Right panel: toolbar + console output + input ════════════ -->
        <DockPanel Grid.Column="1">

            <!-- Toolbar -->
            <Border DockPanel.Dock="Top"
                    Background="{DynamicResource HeaderBrush}"
                    BorderBrush="{DynamicResource SeparatorBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="16,10">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="Console"
                               FontSize="14" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="LIVE"
                               FontSize="9" FontWeight="Bold"
                               Foreground="{DynamicResource AccentBrush}"
                               LetterSpacing="1.5"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Command input + suggestions -->
            <Border DockPanel.Dock="Bottom"
                    Background="{DynamicResource HeaderBrush}"
                    BorderBrush="{DynamicResource SeparatorBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="16,12">
                <DockPanel>
                    <!-- Autocomplete suggestions — sit above the input row -->
                    <Border x:Name="SuggestionsPanel"
                            DockPanel.Dock="Top"
                            IsVisible="{Binding ShowSuggestions}"
                            Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource AccentBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            MaxHeight="110"
                            Margin="0,0,80,8">
                        <ListBox x:Name="SuggestionList"
                                 ItemsSource="{Binding Suggestions}"
                                 Background="Transparent"
                                 SelectionChanged="OnSuggestionSelected"
                                 Padding="4">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}"
                                               FontFamily="Cascadia Code,Consolas,monospace"
                                               FontSize="12"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               Padding="6,3"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>

                    <!-- Input row -->
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBox x:Name="CommandBox"
                                 Grid.Column="0"
                                 Text="{Binding CommandInput}"
                                 Watermark="Enter command…"
                                 FontFamily="Cascadia Code,Consolas,monospace"
                                 FontSize="13"
                                 CornerRadius="8,0,0,8"
                                 KeyDown="OnInputKeyDown"/>
                        <Button Grid.Column="1"
                                Content="Send"
                                Command="{Binding SendCommandCommand}"
                                Theme="{StaticResource PrimaryButton}"
                                FontWeight="SemiBold"
                                CornerRadius="0,8,8,0"
                                Padding="18,9"/>
                    </Grid>
                </DockPanel>
            </Border>

            <!-- Console output -->
            <ScrollViewer x:Name="ConsoleScroll"
                          Background="{DynamicResource BgBrush}"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Entries}" Margin="16,12">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:ConsoleEntry">
                            <TextBlock Text="{Binding Raw}"
                                       FontFamily="Cascadia Code,Consolas,monospace"
                                       FontSize="12"
                                       TextWrapping="NoWrap"
                                       Padding="0,1"
                                       Foreground="{Binding Level, Converter={StaticResource LevelToColorConverter}}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

        </DockPanel>

    </Grid>
</UserControl>
