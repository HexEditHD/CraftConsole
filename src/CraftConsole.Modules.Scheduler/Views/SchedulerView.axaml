<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CraftConsole.Modules.Scheduler.ViewModels"
             xmlns:models="using:CraftConsole.Core.Models"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="960" d:DesignHeight="680"
             x:Class="CraftConsole.Modules.Scheduler.Views.SchedulerView"
             x:DataType="vm:SchedulerViewModel">

    <UserControl.Styles>
        <Style Selector="TextBlock.form-label">
            <Setter Property="FontSize"   Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
            <Setter Property="Margin"     Value="0,0,0,4"/>
        </Style>
        <Style Selector="DataGrid">
            <Setter Property="Background"               Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="BorderBrush"              Value="{DynamicResource SurfaceBorderBrush}"/>
            <Setter Property="BorderThickness"          Value="1"/>
            <Setter Property="CornerRadius"             Value="10"/>
            <Setter Property="GridLinesVisibility"      Value="Horizontal"/>
            <Setter Property="RowBackground"            Value="{DynamicResource SurfaceBrush}"/>
        </Style>
        <Style Selector="DataGridColumnHeader">
            <Setter Property="Background"  Value="{DynamicResource HeaderBrush}"/>
            <Setter Property="Foreground"  Value="{DynamicResource TextMutedBrush}"/>
            <Setter Property="FontSize"    Value="10"/>
            <Setter Property="FontWeight"  Value="SemiBold"/>
            <Setter Property="Padding"     Value="12,10"/>
        </Style>
    </UserControl.Styles>

    <DockPanel>

        <!-- Toolbar -->
        <Border DockPanel.Dock="Top"
                Background="{DynamicResource HeaderBrush}"
                BorderBrush="{DynamicResource SeparatorBrush}"
                BorderThickness="0,0,0,1"
                Padding="20,14">
            <DockPanel>
                <TextBlock Text="Scheduler"
                           FontSize="14" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           VerticalAlignment="Center"/>
                <Button Content="Add Task"
                        Command="{Binding StartAddCommand}"
                        DockPanel.Dock="Right"
                        Theme="{StaticResource PrimaryButton}"
                        Padding="14,6"/>
            </DockPanel>
        </Border>

        <!-- Add/Edit form -->
        <Border DockPanel.Dock="Top"
                IsVisible="{Binding IsAddingNew}"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource SurfaceBorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="20,16">
            <Grid ColumnDefinitions="*,*,*,*,*,Auto" RowDefinitions="Auto,Auto,Auto">

                <!-- Labels -->
                <TextBlock Grid.Column="0" Classes="form-label" Text="NAME"/>
                <TextBlock Grid.Column="1" Classes="form-label" Text="TRIGGER" Margin="12,0,0,4"/>
                <TextBlock Grid.Column="2" Classes="form-label" Text="TRIGGER VALUE" Margin="12,0,0,4"/>
                <TextBlock Grid.Column="3" Classes="form-label" Text="ACTION" Margin="12,0,0,4"/>
                <TextBlock Grid.Column="4" Classes="form-label" Text="ACTION VALUE" Margin="12,0,0,4"/>

                <!-- Inputs -->
                <TextBox Grid.Row="1" Grid.Column="0"
                         Text="{Binding FormName}"
                         Watermark="Task name"/>
                <ComboBox Grid.Row="1" Grid.Column="1"
                          ItemsSource="{x:Static vm:SchedulerViewModel.AllTriggerTypes}"
                          SelectedItem="{Binding FormTriggerType}"
                          Margin="12,0,0,0"
                          HorizontalAlignment="Stretch"/>
                <TextBox Grid.Row="1" Grid.Column="2"
                         Text="{Binding FormTriggerValue}"
                         Watermark="e.g. 30 or 14:30"
                         Margin="12,0,0,0"/>
                <ComboBox Grid.Row="1" Grid.Column="3"
                          ItemsSource="{x:Static vm:SchedulerViewModel.AllActionTypes}"
                          SelectedItem="{Binding FormActionType}"
                          Margin="12,0,0,0"
                          HorizontalAlignment="Stretch"/>
                <TextBox Grid.Row="1" Grid.Column="4"
                         Text="{Binding FormActionValue}"
                         Watermark="Command or message"
                         Margin="12,0,0,0"/>

                <!-- Actions -->
                <StackPanel Grid.Row="2" Grid.Column="5"
                            Orientation="Horizontal"
                            Spacing="8"
                            VerticalAlignment="Center"
                            Margin="12,10,0,0">
                    <Button Content="Cancel"
                            Command="{Binding CancelAddCommand}"
                            Padding="14,6"/>
                    <Button Content="Save"
                            Command="{Binding SaveTaskCommand}"
                            Theme="{StaticResource PrimaryButton}"
                            Padding="14,6"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Tasks DataGrid -->
        <DataGrid ItemsSource="{Binding Tasks}"
                  AutoGenerateColumns="False"
                  CanUserReorderColumns="False"
                  CanUserResizeColumns="True"
                  CanUserSortColumns="True"
                  x:CompileBindings="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Name"          Binding="{Binding Name}"         Width="140" IsReadOnly="True"/>
                <DataGridTextColumn Header="Trigger"       Binding="{Binding TriggerType}"   Width="100" IsReadOnly="True"/>
                <DataGridTextColumn Header="Trigger Value" Binding="{Binding TriggerValue}"  Width="100" IsReadOnly="True"/>
                <DataGridTextColumn Header="Action"        Binding="{Binding ActionType}"    Width="140" IsReadOnly="True"/>
                <DataGridTextColumn Header="Action Value"  Binding="{Binding ActionValue}"   Width="*"   IsReadOnly="True"/>
                <DataGridCheckBoxColumn Header="Enabled"   Binding="{Binding IsEnabled}"     Width="70"/>
                <DataGridTemplateColumn Header="" Width="190" IsReadOnly="True">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="models:ScheduledTask">
                            <StackPanel Orientation="Horizontal" Spacing="6" Margin="4,2">
                                <Button Content="Test"
                                        Theme="{StaticResource PrimaryButton}"
                                        Command="{Binding $parent[UserControl].((vm:SchedulerViewModel)DataContext).TestTaskCommand}"
                                        CommandParameter="{Binding}"
                                        Padding="10,4" FontSize="11"/>
                                <Button Content="Edit"
                                        Command="{Binding $parent[UserControl].((vm:SchedulerViewModel)DataContext).EditTaskCommand}"
                                        CommandParameter="{Binding}"
                                        Padding="10,4" FontSize="11"/>
                                <Button Content="Delete"
                                        Theme="{StaticResource DangerButton}"
                                        Command="{Binding $parent[UserControl].((vm:SchedulerViewModel)DataContext).DeleteTaskCommand}"
                                        CommandParameter="{Binding}"
                                        Padding="10,4" FontSize="11"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

    </DockPanel>
</UserControl>
