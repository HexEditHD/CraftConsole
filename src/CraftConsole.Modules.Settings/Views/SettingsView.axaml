<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CraftConsole.Modules.Settings.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="700" d:DesignHeight="680"
             x:Class="CraftConsole.Modules.Settings.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">

    <UserControl.Styles>
        <Style Selector="Border.card">
            <Setter Property="Background"      Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource SurfaceBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="10"/>
            <Setter Property="Padding"         Value="20"/>
        </Style>
        <Style Selector="TextBlock.section-head">
            <Setter Property="FontSize"      Value="11"/>
            <Setter Property="FontWeight"    Value="SemiBold"/>
            <Setter Property="Foreground"    Value="{DynamicResource TextMutedBrush}"/>
            <Setter Property="LetterSpacing" Value="1.2"/>
            <Setter Property="Margin"        Value="0,0,0,10"/>
        </Style>
    </UserControl.Styles>

    <DockPanel>
        <!-- Header -->
        <Border DockPanel.Dock="Top"
                Background="{DynamicResource HeaderBrush}"
                BorderBrush="{DynamicResource SeparatorBrush}"
                BorderThickness="0,0,0,1"
                Padding="20,14">
            <TextBlock Text="Settings"
                       FontSize="14" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}"/>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="20" Margin="20,20,20,20">

                <!-- Console Display -->
                <StackPanel Spacing="0">
                    <TextBlock Classes="section-head" Text="CONSOLE DISPLAY"/>
                    <Border Classes="card">
                        <StackPanel Spacing="12">
                            <CheckBox Content="Show Timestamp"
                                      IsChecked="{Binding ShowTimestamp}"
                                      Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <CheckBox Content="Show Date"
                                      IsChecked="{Binding ShowDate}"
                                      Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Log Level Colors -->
                <StackPanel Spacing="0">
                    <DockPanel Margin="0,0,0,10">
                        <TextBlock Classes="section-head" Text="LOG LEVEL COLORS" Margin="0"/>
                        <Button Content="Reset Defaults"
                                Command="{Binding ResetColorsCommand}"
                                DockPanel.Dock="Right"
                                Padding="12,4"
                                FontSize="11"/>
                    </DockPanel>
                    <Border Classes="card">
                        <StackPanel Spacing="16">

                            <!-- Info -->
                            <Grid ColumnDefinitions="80,*,140">
                                <TextBlock Grid.Column="0"
                                           Text="Info"
                                           FontWeight="SemiBold"
                                           Foreground="{Binding ColorInfo, Converter={StaticResource StringToBrushConverter}}"
                                           VerticalAlignment="Center"/>
                                <ItemsControl Grid.Column="1"
                                              ItemsSource="{x:Static vm:SettingsViewModel.InfoSwatches}"
                                              Margin="8,0">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="6"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Width="22" Height="22"
                                                    CornerRadius="11"
                                                    Background="{Binding Converter={StaticResource StringToBrushConverter}}"
                                                    BorderThickness="0"
                                                    Padding="0"
                                                    Command="{Binding $parent[UserControl].((vm:SettingsViewModel)DataContext).SetInfoColorCommand}"
                                                    CommandParameter="{Binding}"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBox Grid.Column="2"
                                         Text="{Binding ColorInfo}"
                                         Watermark="#94A3B8"
                                         Margin="8,0,0,0"
                                         FontFamily="Consolas,monospace"
                                         FontSize="12"/>
                            </Grid>

                            <!-- Warn -->
                            <Grid ColumnDefinitions="80,*,140">
                                <TextBlock Grid.Column="0"
                                           Text="Warn"
                                           FontWeight="SemiBold"
                                           Foreground="{Binding ColorWarn, Converter={StaticResource StringToBrushConverter}}"
                                           VerticalAlignment="Center"/>
                                <ItemsControl Grid.Column="1"
                                              ItemsSource="{x:Static vm:SettingsViewModel.WarnSwatches}"
                                              Margin="8,0">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="6"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Width="22" Height="22"
                                                    CornerRadius="11"
                                                    Background="{Binding Converter={StaticResource StringToBrushConverter}}"
                                                    BorderThickness="0"
                                                    Padding="0"
                                                    Command="{Binding $parent[UserControl].((vm:SettingsViewModel)DataContext).SetWarnColorCommand}"
                                                    CommandParameter="{Binding}"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBox Grid.Column="2"
                                         Text="{Binding ColorWarn}"
                                         Watermark="#FB923C"
                                         Margin="8,0,0,0"
                                         FontFamily="Consolas,monospace"
                                         FontSize="12"/>
                            </Grid>

                            <!-- Error -->
                            <Grid ColumnDefinitions="80,*,140">
                                <TextBlock Grid.Column="0"
                                           Text="Error"
                                           FontWeight="SemiBold"
                                           Foreground="{Binding ColorError, Converter={StaticResource StringToBrushConverter}}"
                                           VerticalAlignment="Center"/>
                                <ItemsControl Grid.Column="1"
                                              ItemsSource="{x:Static vm:SettingsViewModel.ErrorSwatches}"
                                              Margin="8,0">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="6"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Width="22" Height="22"
                                                    CornerRadius="11"
                                                    Background="{Binding Converter={StaticResource StringToBrushConverter}}"
                                                    BorderThickness="0"
                                                    Padding="0"
                                                    Command="{Binding $parent[UserControl].((vm:SettingsViewModel)DataContext).SetErrorColorCommand}"
                                                    CommandParameter="{Binding}"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBox Grid.Column="2"
                                         Text="{Binding ColorError}"
                                         Watermark="#F87171"
                                         Margin="8,0,0,0"
                                         FontFamily="Consolas,monospace"
                                         FontSize="12"/>
                            </Grid>

                            <!-- Player -->
                            <Grid ColumnDefinitions="80,*,140">
                                <TextBlock Grid.Column="0"
                                           Text="Player"
                                           FontWeight="SemiBold"
                                           Foreground="{Binding ColorPlayer, Converter={StaticResource StringToBrushConverter}}"
                                           VerticalAlignment="Center"/>
                                <ItemsControl Grid.Column="1"
                                              ItemsSource="{x:Static vm:SettingsViewModel.PlayerSwatches}"
                                              Margin="8,0">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="6"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Width="22" Height="22"
                                                    CornerRadius="11"
                                                    Background="{Binding Converter={StaticResource StringToBrushConverter}}"
                                                    BorderThickness="0"
                                                    Padding="0"
                                                    Command="{Binding $parent[UserControl].((vm:SettingsViewModel)DataContext).SetPlayerColorCommand}"
                                                    CommandParameter="{Binding}"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBox Grid.Column="2"
                                         Text="{Binding ColorPlayer}"
                                         Watermark="#22C55E"
                                         Margin="8,0,0,0"
                                         FontFamily="Consolas,monospace"
                                         FontSize="12"/>
                            </Grid>

                        </StackPanel>
                    </Border>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
