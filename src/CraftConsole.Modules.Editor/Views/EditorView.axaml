<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CraftConsole.Modules.Editor.ViewModels"
             xmlns:models="using:CraftConsole.Modules.Editor.Models"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="960" d:DesignHeight="680"
             x:Class="CraftConsole.Modules.Editor.Views.EditorView"
             x:DataType="vm:EditorViewModel">

    <UserControl.KeyBindings>
        <KeyBinding Gesture="Ctrl+S" Command="{Binding SaveTabCommand}"/>
    </UserControl.KeyBindings>

    <Grid ColumnDefinitions="220,*">

        <!-- ══ Left: File tree ══════════════════════════════════════════ -->
        <Border Grid.Column="0"
                Background="{DynamicResource HeaderBrush}"
                BorderBrush="{DynamicResource SeparatorBrush}"
                BorderThickness="0,0,1,0">
            <DockPanel>
                <Border DockPanel.Dock="Top"
                        BorderBrush="{DynamicResource SeparatorBrush}"
                        BorderThickness="0,0,0,1"
                        Padding="12,10">
                    <TextBlock Text="FILES"
                               FontSize="10" FontWeight="SemiBold"
                               LetterSpacing="1.2"
                               Foreground="{DynamicResource TextMutedBrush}"/>
                </Border>
                <!-- Sort toolbar -->
                <Border DockPanel.Dock="Top"
                        BorderBrush="{DynamicResource SeparatorBrush}"
                        BorderThickness="0,0,0,1"
                        Padding="8,5">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="Sort:"
                                   FontSize="10"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   VerticalAlignment="Center"/>
                        <Button Content="Name"
                                Command="{Binding SortByNameCommand}"
                                FontSize="10" Padding="6,3"/>
                        <Button Content="Size"
                                Command="{Binding SortBySizeCommand}"
                                FontSize="10" Padding="6,3"/>
                    </StackPanel>
                </Border>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <TreeView x:Name="FileTreeView"
                              ItemsSource="{Binding FileTree}"
                              DoubleTapped="OnTreeDoubleTapped"
                              Margin="4,4"
                              Background="Transparent">
                        <TreeView.ItemTemplate>
                            <TreeDataTemplate x:DataType="models:FileNode"
                                              ItemsSource="{Binding Children}">
                                <StackPanel Orientation="Horizontal" Spacing="6" Margin="2,3">
                                    <TextBlock Text="📁" IsVisible="{Binding IsDirectory}" FontSize="12"/>
                                    <TextBlock Text="📄" IsVisible="{Binding !IsDirectory}" FontSize="12"/>
                                    <TextBlock Text="{Binding Name}"
                                               FontSize="12"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                </StackPanel>
                            </TreeDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- ══ Right: Tab bar + editor ══════════════════════════════════ -->
        <Grid Grid.Column="1" RowDefinitions="Auto,*">

            <!-- Tab bar -->
            <ScrollViewer Grid.Row="0"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Disabled"
                          Background="{DynamicResource HeaderBrush}"
                          HorizontalAlignment="Stretch">
                <ItemsControl ItemsSource="{Binding Tabs}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:EditorTab">
                            <Border BorderBrush="{DynamicResource SeparatorBrush}"
                                    BorderThickness="0,0,1,0"
                                    Padding="12,8">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Background="Transparent"
                                            BorderThickness="0"
                                            Padding="0"
                                            Click="OnTabClick">
                                        <TextBlock Text="{Binding DisplayTitle}"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    </Button>
                                    <Button Content="×"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Padding="2,0"
                                            FontSize="14"
                                            Foreground="{DynamicResource TextMutedBrush}"
                                            Command="{Binding $parent[UserControl].((vm:EditorViewModel)DataContext).CloseTabCommand}"
                                            CommandParameter="{Binding}"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Editor content -->
            <ContentControl Grid.Row="1" Content="{Binding SelectedTab}">
                <ContentControl.ContentTemplate>
                    <DataTemplate x:DataType="models:EditorTab">
                        <TextBox Text="{Binding Content}"
                                 AcceptsReturn="True"
                                 AcceptsTab="True"
                                 TextWrapping="NoWrap"
                                 FontFamily="Cascadia Code,Consolas,Courier New,monospace"
                                 FontSize="13"
                                 Background="{DynamicResource BgBrush}"
                                 BorderThickness="0"
                                 CornerRadius="0"
                                 HorizontalAlignment="Stretch"
                                 VerticalAlignment="Stretch"
                                 Padding="16,12"/>
                    </DataTemplate>
                </ContentControl.ContentTemplate>
            </ContentControl>

        </Grid>

    </Grid>
</UserControl>
