<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CraftConsole.Modules.Players.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="960" d:DesignHeight="680"
             x:Class="CraftConsole.Modules.Players.Views.PlayersView"
             x:DataType="vm:PlayersViewModel">

    <UserControl.Styles>
        <Style Selector="TextBlock.section-label">
            <Setter Property="FontSize"      Value="11"/>
            <Setter Property="FontWeight"    Value="SemiBold"/>
            <Setter Property="Foreground"    Value="{DynamicResource TextMutedBrush}"/>
            <Setter Property="LetterSpacing" Value="1.2"/>
            <Setter Property="Margin"        Value="0,0,0,8"/>
        </Style>
        <Style Selector="DataGrid">
            <Setter Property="Background"             Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="BorderBrush"            Value="{DynamicResource SurfaceBorderBrush}"/>
            <Setter Property="BorderThickness"        Value="1"/>
            <Setter Property="CornerRadius"           Value="10"/>
            <Setter Property="GridLinesVisibility"    Value="Horizontal"/>
            <Setter Property="RowBackground"          Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Auto"/>
        </Style>
        <Style Selector="DataGridColumnHeader">
            <Setter Property="Background"  Value="{DynamicResource HeaderBrush}"/>
            <Setter Property="Foreground"  Value="{DynamicResource TextMutedBrush}"/>
            <Setter Property="FontSize"    Value="10"/>
            <Setter Property="FontWeight"  Value="SemiBold"/>
            <Setter Property="Padding"     Value="12,10"/>
        </Style>
        <Style Selector="DataGridRow:selected">
            <Setter Property="Background" Value="{DynamicResource AccentDimBrush}"/>
        </Style>
        <Style Selector="DataGridRow:pointerover">
            <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}"/>
        </Style>
    </UserControl.Styles>

    <DockPanel>

        <!-- Header -->
        <Border DockPanel.Dock="Top" Padding="0,0,0,20">
            <StackPanel Spacing="3">
                <TextBlock Text="Players"
                           FontSize="22" FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                <TextBlock Text="Manage connected and banned players"
                           FontSize="12"
                           Foreground="{DynamicResource TextMutedBrush}"/>
            </StackPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="20">

                <!-- Online players -->
                <StackPanel Spacing="0">
                    <TextBlock Classes="section-label" Text="ONLINE PLAYERS"/>
                    <DataGrid x:Name="OnlineGrid"
                              ItemsSource="{Binding Players}"
                              SelectedItem="{Binding SelectedPlayer}"
                              IsReadOnly="True"
                              AutoGenerateColumns="False"
                              CanUserReorderColumns="False"
                              CanUserResizeColumns="True"
                              x:CompileBindings="False"
                              CellPointerPressed="OnOnlineGridCellPointerPressed">

                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Kick…"   Command="{Binding KickPlayerCommand}"/>
                                <MenuItem Header="Ban…"    Command="{Binding BanPlayerCommand}"/>
                                <MenuItem Header="Ban IP…" Command="{Binding BanPlayerIpCommand}"/>
                            </ContextMenu>
                        </DataGrid.ContextMenu>

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Username"     Binding="{Binding Username}"                                 Width="130" MinWidth="90"/>
                            <DataGridTextColumn Header="Display Name" Binding="{Binding DisplayName}"                              Width="140" MinWidth="110"/>
                            <DataGridTextColumn Header="IP Address"   Binding="{Binding IpAddress}"                                Width="130" MinWidth="90"/>
                            <DataGridTextColumn Header="Joined"       Binding="{Binding JoinedAt, StringFormat=\{0:HH:mm:ss\}}"   Width="95"  MinWidth="75"/>
                            <DataGridTextColumn Header="Last Seen"    Binding="{Binding LastSeen, StringFormat=\{0:HH:mm:ss\}}"   Width="100" MinWidth="85"/>
                            <DataGridTextColumn Header="Location"     Binding="{Binding Location}"                                 Width="*"   MinWidth="100"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>

                <!-- Banned players -->
                <StackPanel Spacing="0">
                    <TextBlock Classes="section-label" Text="BANNED PLAYERS"/>
                    <DataGrid x:Name="BannedGrid"
                              ItemsSource="{Binding BannedPlayers}"
                              SelectedItem="{Binding SelectedBannedPlayer}"
                              IsReadOnly="True"
                              AutoGenerateColumns="False"
                              CanUserReorderColumns="False"
                              CanUserResizeColumns="True"
                              x:CompileBindings="False"
                              CellPointerPressed="OnBannedGridCellPointerPressed">

                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Pardon" Command="{Binding PardonPlayerCommand}"/>
                            </ContextMenu>
                        </DataGrid.ContextMenu>

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Username"   Binding="{Binding Name}"    Width="130" MinWidth="90"/>
                            <DataGridTextColumn Header="Created At" Binding="{Binding Created}" Width="160" MinWidth="100"/>
                            <DataGridTextColumn Header="Created By" Binding="{Binding Source}"  Width="120" MinWidth="90"/>
                            <DataGridTextColumn Header="Expires"    Binding="{Binding Expires}" Width="100" MinWidth="75"/>
                            <DataGridTextColumn Header="Reason"     Binding="{Binding Reason}"  Width="*"   MinWidth="80"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>

                <!-- Banned IPs -->
                <StackPanel Spacing="0">
                    <TextBlock Classes="section-label" Text="BANNED IPS"/>
                    <DataGrid x:Name="BannedIpsGrid"
                              ItemsSource="{Binding BannedIps}"
                              SelectedItem="{Binding SelectedBannedIp}"
                              IsReadOnly="True"
                              AutoGenerateColumns="False"
                              CanUserReorderColumns="False"
                              CanUserResizeColumns="True"
                              x:CompileBindings="False"
                              CellPointerPressed="OnBannedIpsGridCellPointerPressed">

                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Pardon IP" Command="{Binding PardonIpCommand}"/>
                            </ContextMenu>
                        </DataGrid.ContextMenu>

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="IP Address" Binding="{Binding Ip}"      Width="130" MinWidth="90"/>
                            <DataGridTextColumn Header="Banned At"  Binding="{Binding Created}" Width="160" MinWidth="100"/>
                            <DataGridTextColumn Header="Expires"    Binding="{Binding Expires}" Width="100" MinWidth="75"/>
                            <DataGridTextColumn Header="Reason"     Binding="{Binding Reason}"  Width="*"   MinWidth="80"/>
                            <DataGridTextColumn Header="Source"     Binding="{Binding Source}"  Width="100" MinWidth="70"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>

    </DockPanel>
</UserControl>
