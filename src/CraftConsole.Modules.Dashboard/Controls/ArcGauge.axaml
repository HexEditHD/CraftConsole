<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shapes="using:Avalonia.Controls.Shapes"
             xmlns:local="using:CraftConsole.Modules.Dashboard.Controls"
             x:Class="CraftConsole.Modules.Dashboard.Controls.ArcGauge"
             x:DataType="local:ArcGauge">

    <Canvas Width="90" Height="90">

        <!-- Track arc (full 270°) -->
        <shapes:Arc Canvas.Left="8" Canvas.Top="8"
                    Width="74" Height="74"
                    StartAngle="135" SweepAngle="270"
                    Stroke="{DynamicResource SurfaceAltBrush}"
                    StrokeThickness="8"
                    StrokeLineCap="Round"/>

        <!-- Fill arc (value-proportional) -->
        <shapes:Arc Canvas.Left="8" Canvas.Top="8"
                    Width="74" Height="74"
                    StartAngle="135"
                    SweepAngle="{Binding SweepAngle, RelativeSource={RelativeSource AncestorType=local:ArcGauge}}"
                    Stroke="{Binding GaugeColor, RelativeSource={RelativeSource AncestorType=local:ArcGauge}}"
                    StrokeThickness="8"
                    StrokeLineCap="Round"/>

        <!-- Center text -->
        <StackPanel Canvas.Left="0" Canvas.Top="0"
                    Width="90" Height="90"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Spacing="1">
            <TextBlock Text="{Binding Value, RelativeSource={RelativeSource AncestorType=local:ArcGauge}, StringFormat='{}{0:F0}'}"
                       FontSize="20" FontWeight="Bold"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
            <TextBlock Text="{Binding Unit, RelativeSource={RelativeSource AncestorType=local:ArcGauge}}"
                       FontSize="9" FontWeight="Medium"
                       Foreground="{DynamicResource TextMutedBrush}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
        </StackPanel>

    </Canvas>

</UserControl>
