<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CraftConsole.Modules.Server.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="960" d:DesignHeight="680"
             xmlns:java="using:CraftConsole.Core.Java"
             xmlns:infra="using:CraftConsole.Infrastructure.Http"
             x:Class="CraftConsole.Modules.Server.Views.ServerView"
             x:DataType="vm:ServerViewModel">

    <UserControl.Styles>

        <Style Selector="Border.card">
            <Setter Property="Background"      Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource SurfaceBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="{DynamicResource CardRadius}"/>
            <Setter Property="Padding"         Value="20"/>
        </Style>

        <Style Selector="TextBlock.field-label">
            <Setter Property="FontSize"     Value="10"/>
            <Setter Property="FontWeight"   Value="SemiBold"/>
            <Setter Property="Foreground"   Value="{DynamicResource TextMutedBrush}"/>
            <Setter Property="LetterSpacing" Value="1.2"/>
            <Setter Property="Margin"       Value="0,0,0,5"/>
        </Style>

    </UserControl.Styles>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="16" Margin="0,0,0,8">

            <!-- ── Page header ── -->
            <StackPanel Spacing="3">
                <TextBlock Text="Server"
                           FontSize="22" FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                <TextBlock Text="Configure and manage your Minecraft server"
                           FontSize="12"
                           Foreground="{DynamicResource TextMutedBrush}"/>
            </StackPanel>

            <!-- ── Config + Download row ── -->
            <Grid ColumnDefinitions="*,Auto">

                <!-- Left: configuration form -->
                <Border Classes="card">
                    <StackPanel Spacing="16">

                        <!-- Server Name -->
                        <StackPanel Spacing="0">
                            <TextBlock Classes="field-label" Text="SERVER NAME"/>
                            <TextBox Text="{Binding ServerName}"
                                     Watermark="My Server"/>
                        </StackPanel>

                        <!-- Java Installation -->
                        <StackPanel Spacing="0">
                            <TextBlock Classes="field-label" Text="JAVA INSTALLATION"/>
                            <Grid ColumnDefinitions="*,Auto">
                                <ComboBox Grid.Column="0"
                                          ItemsSource="{Binding JavaInstallations}"
                                          SelectedItem="{Binding SelectedJava}"
                                          PlaceholderText="No Java found"
                                          Background="{DynamicResource SurfaceAltBrush}"
                                          BorderBrush="{DynamicResource SurfaceBorderBrush}"
                                          Foreground="{DynamicResource TextPrimaryBrush}"
                                          CornerRadius="8,0,0,8"
                                          HorizontalAlignment="Stretch"
                                          Padding="12,9">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="java:JavaInstallation">
                                            <TextBlock Text="{Binding Label}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <Button Grid.Column="1"
                                        Command="{Binding DetectJavaCommand}"
                                        IsEnabled="{Binding !IsDetectingJava}"
                                        CornerRadius="0,8,8,0"
                                        Padding="14,9">
                                    <Panel>
                                        <TextBlock Text="Scan"      IsVisible="{Binding !IsDetectingJava}"/>
                                        <TextBlock Text="Scanning…" IsVisible="{Binding IsDetectingJava}"/>
                                    </Panel>
                                </Button>
                            </Grid>
                        </StackPanel>

                        <!-- RAM -->
                        <Grid ColumnDefinitions="*,12,*">
                            <StackPanel Grid.Column="0" Spacing="0">
                                <TextBlock Classes="field-label" Text="MIN MEMORY (MB)"/>
                                <TextBox Text="{Binding MinRamMb}"
                                         Watermark="512"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Spacing="0">
                                <TextBlock Classes="field-label" Text="MAX MEMORY (MB)"/>
                                <TextBox Text="{Binding MaxRamMb}"
                                         Watermark="2048"/>
                            </StackPanel>
                        </Grid>

                        <!-- JAR Path -->
                        <StackPanel Spacing="0">
                            <TextBlock Classes="field-label" Text="SERVER JAR PATH"/>
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBox Grid.Column="0"
                                         Text="{Binding JarPath}"
                                         Watermark="Path to server.jar"
                                         CornerRadius="8,0,0,8"/>
                                <Button Grid.Column="1"
                                        Content="…"
                                        Command="{Binding BrowseJarCommand}"
                                        CornerRadius="0,8,8,0"
                                        Padding="14,9"
                                        FontSize="14"/>
                            </Grid>
                        </StackPanel>

                        <!-- JVM Flags -->
                        <StackPanel Spacing="0">
                            <TextBlock Classes="field-label" Text="EXTRA JVM FLAGS (OPTIONAL)"/>
                            <TextBox Text="{Binding JvmArguments}"
                                     Watermark="-XX:+UseG1GC -XX:+ParallelRefProcEnabled"/>
                        </StackPanel>

                        <!-- Separator -->
                        <Border Height="1"
                                Background="{DynamicResource SeparatorBrush}"
                                Margin="-20,4"/>

                        <!-- Start / Stop controls -->
                        <Grid ColumnDefinitions="*,8,Auto">
                            <Button Grid.Column="0"
                                    Content="Start Server"
                                    Command="{Binding StartServerCommand}"
                                    IsEnabled="{Binding CanStart}"
                                    Theme="{StaticResource PrimaryButton}"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"
                                    Padding="0,10"/>
                            <Button Grid.Column="2"
                                    Content="Stop"
                                    Command="{Binding StopServerCommand}"
                                    IsEnabled="{Binding CanStop}"
                                    Theme="{StaticResource DangerButton}"
                                    Padding="20,10"/>
                        </Grid>

                        <!-- Running status label -->
                        <TextBlock Text="{Binding Status, StringFormat='Status: {0}'}"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center"/>

                    </StackPanel>
                </Border>

                <!-- Right: always-visible download panel -->
                <Border Grid.Column="1"
                        Classes="card"
                        Width="310"
                        Margin="12,0,0,0"
                        VerticalAlignment="Top">
                    <StackPanel Spacing="0">

                        <!-- ══ SERVER DOWNLOAD ══════════════════════════════ -->
                        <StackPanel Spacing="12">

                            <TextBlock Text="SERVER DOWNLOAD"
                                       FontSize="10" FontWeight="SemiBold"
                                       LetterSpacing="1.2"
                                       Foreground="{DynamicResource TextMutedBrush}"/>

                            <!-- Server type dropdown -->
                            <TextBlock Classes="field-label" Text="SERVER TYPE"/>
                            <ComboBox ItemsSource="{x:Static vm:ServerViewModel.AllServerTypes}"
                                      SelectedItem="{Binding SelectedServerType}"
                                      PlaceholderText="Select server type…"
                                      Background="{DynamicResource SurfaceAltBrush}"
                                      BorderBrush="{DynamicResource SurfaceBorderBrush}"
                                      Foreground="{DynamicResource TextPrimaryBrush}"
                                      HorizontalAlignment="Stretch"
                                      Padding="12,9">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ServerTypeInfo">
                                        <TextBlock Text="{Binding DisplayName}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <!-- Server type selected content -->
                            <StackPanel IsVisible="{Binding ServerTypeSelected}" Spacing="12">

                                <!-- Type info -->
                                <StackPanel Spacing="3">
                                    <TextBlock Text="{Binding SelectedServerType.Tag}"
                                               FontSize="9" FontWeight="Bold"
                                               LetterSpacing="1.2"
                                               Foreground="{DynamicResource AccentBrush}"/>
                                    <TextBlock Text="{Binding SelectedServerType.DisplayName}"
                                               FontSize="16" FontWeight="Bold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="{Binding SelectedServerType.Description}"
                                               FontSize="11"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               TextWrapping="Wrap"/>
                                </StackPanel>

                                <!-- Auto-download controls -->
                                <StackPanel IsVisible="{Binding SelectedServerType.HasAutoDownload}"
                                            Spacing="8">
                                    <TextBlock Text="VERSION"
                                               FontSize="9" FontWeight="SemiBold"
                                               LetterSpacing="1.2"
                                               Foreground="{DynamicResource TextMutedBrush}"/>
                                    <ComboBox ItemsSource="{Binding AvailableVersions}"
                                              SelectedItem="{Binding SelectedVersion}"
                                              IsEnabled="{Binding !IsFetchingVersions}"
                                              PlaceholderText="Loading versions…"
                                              Background="{DynamicResource SurfaceAltBrush}"
                                              BorderBrush="{DynamicResource SurfaceBorderBrush}"
                                              Foreground="{DynamicResource TextPrimaryBrush}"
                                              HorizontalAlignment="Stretch"
                                              Padding="12,9"/>
                                    <Button Content="Download JAR"
                                            Command="{Binding DownloadServerCommand}"
                                            IsEnabled="{Binding CanDownload}"
                                            Theme="{StaticResource PrimaryButton}"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Center"/>
                                    <StackPanel IsVisible="{Binding IsDownloading}" Spacing="6">
                                        <ProgressBar Value="{Binding DownloadProgress}"
                                                     Maximum="1.0" Height="4"/>
                                        <Button Content="Cancel"
                                                Command="{Binding CancelDownloadCommand}"
                                                HorizontalAlignment="Right"
                                                Padding="10,4" FontSize="11"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding DownloadStatusText}"
                                               FontSize="11"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               TextWrapping="Wrap"
                                               IsVisible="{Binding DownloadStatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                </StackPanel>

                                <!-- Manual download notice -->
                                <Border IsVisible="{Binding !SelectedServerType.HasAutoDownload}"
                                        Background="{DynamicResource WarnDimBrush}"
                                        BorderBrush="{DynamicResource WarnBrush}"
                                        BorderThickness="1" CornerRadius="8" Padding="12,10">
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="MANUAL INSTALL REQUIRED"
                                                   FontSize="9" FontWeight="Bold"
                                                   LetterSpacing="1.2"
                                                   Foreground="{DynamicResource WarnBrush}"/>
                                        <TextBlock Text="{Binding DownloadStatusText}"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   TextWrapping="Wrap"/>
                                        <TextBlock Text="Browse for the JAR using the '…' button in the form on the left once downloaded."
                                                   FontSize="10"
                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>

                            </StackPanel>
                        </StackPanel>

                        <!-- ── Section divider ─────────────────────────────── -->
                        <Border Height="1"
                                Background="{DynamicResource SeparatorBrush}"
                                Margin="-20,16"/>

                        <!-- ══ JAVA DOWNLOAD ════════════════════════════════ -->
                        <StackPanel Spacing="12" Margin="0,14,0,0">

                            <TextBlock Text="JAVA DOWNLOAD"
                                       FontSize="10" FontWeight="SemiBold"
                                       LetterSpacing="1.2"
                                       Foreground="{DynamicResource TextMutedBrush}"/>

                            <StackPanel Spacing="3">
                                <TextBlock Text="Eclipse Temurin JDK"
                                           FontSize="16" FontWeight="Bold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Text="Open-source, production-ready builds from the Adoptium Working Group."
                                           FontSize="11"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>

                            <TextBlock Text="VERSION"
                                       FontSize="9" FontWeight="SemiBold"
                                       LetterSpacing="1.2"
                                       Foreground="{DynamicResource TextMutedBrush}"/>

                            <ComboBox ItemsSource="{Binding AvailableJavaVersions}"
                                      SelectedItem="{Binding SelectedJavaVersion}"
                                      IsEnabled="{Binding !IsFetchingJavaVersions}"
                                      PlaceholderText="Loading versions…"
                                      Background="{DynamicResource SurfaceAltBrush}"
                                      BorderBrush="{DynamicResource SurfaceBorderBrush}"
                                      Foreground="{DynamicResource TextPrimaryBrush}"
                                      HorizontalAlignment="Stretch"
                                      Padding="12,9">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="infra:JavaVersionInfo">
                                        <TextBlock Text="{Binding DisplayName}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <Button Content="Download JDK Installer"
                                    Command="{Binding DownloadJavaCommand}"
                                    IsEnabled="{Binding CanDownloadJava}"
                                    Theme="{StaticResource PrimaryButton}"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"/>

                            <StackPanel IsVisible="{Binding IsDownloadingJava}" Spacing="6">
                                <ProgressBar Value="{Binding JavaDownloadProgress}"
                                             Maximum="1.0" Height="4"/>
                                <Button Content="Cancel"
                                        Command="{Binding CancelJavaDownloadCommand}"
                                        HorizontalAlignment="Right"
                                        Padding="10,4" FontSize="11"/>
                            </StackPanel>

                            <TextBlock Text="{Binding JavaDownloadStatusText}"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextWrapping="Wrap"
                                       IsVisible="{Binding JavaDownloadStatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

                        </StackPanel>

                    </StackPanel>
                </Border>

            </Grid>

        </StackPanel>
    </ScrollViewer>
</UserControl>
