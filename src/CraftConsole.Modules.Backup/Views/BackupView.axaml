<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CraftConsole.Modules.Backup.ViewModels"
             xmlns:models="using:CraftConsole.Core.Models"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="960" d:DesignHeight="680"
             x:Class="CraftConsole.Modules.Backup.Views.BackupView"
             x:DataType="vm:BackupViewModel">

    <UserControl.Styles>
        <Style Selector="TextBlock.form-label">
            <Setter Property="FontSize"   Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
            <Setter Property="Margin"     Value="0,0,0,4"/>
        </Style>
        <Style Selector="DataGrid">
            <Setter Property="Background"               Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="BorderBrush"              Value="{DynamicResource SurfaceBorderBrush}"/>
            <Setter Property="BorderThickness"          Value="1"/>
            <Setter Property="CornerRadius"             Value="10"/>
            <Setter Property="GridLinesVisibility"      Value="Horizontal"/>
            <Setter Property="RowBackground"            Value="{DynamicResource SurfaceBrush}"/>
        </Style>
        <Style Selector="DataGridColumnHeader">
            <Setter Property="Background"  Value="{DynamicResource HeaderBrush}"/>
            <Setter Property="Foreground"  Value="{DynamicResource TextMutedBrush}"/>
            <Setter Property="FontSize"    Value="10"/>
            <Setter Property="FontWeight"  Value="SemiBold"/>
            <Setter Property="Padding"     Value="12,10"/>
        </Style>
    </UserControl.Styles>

    <DockPanel>

        <!-- Toolbar -->
        <Border DockPanel.Dock="Top"
                Background="{DynamicResource HeaderBrush}"
                BorderBrush="{DynamicResource SeparatorBrush}"
                BorderThickness="0,0,0,1"
                Padding="20,14">
            <DockPanel>
                <TextBlock Text="Backup"
                           FontSize="14" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           VerticalAlignment="Center"/>
                <Button Content="Add Job"
                        Command="{Binding StartAddCommand}"
                        DockPanel.Dock="Right"
                        Theme="{StaticResource PrimaryButton}"
                        Padding="14,6"/>
            </DockPanel>
        </Border>

        <!-- Add/Edit form -->
        <Border DockPanel.Dock="Top"
                IsVisible="{Binding IsAddingNew}"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource SurfaceBorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="20,16">
            <Grid ColumnDefinitions="*,*,*,*,Auto" RowDefinitions="Auto,Auto,Auto" HorizontalAlignment="Stretch">

                <!-- Row 0: Labels -->
                <TextBlock Grid.Column="0" Classes="form-label" Text="NAME"/>
                <TextBlock Grid.Column="1" Classes="form-label" Text="SOURCE PATHS (semicolon-separated)" Margin="12,0,0,4"/>
                <TextBlock Grid.Column="2" Classes="form-label" Text="DESTINATION" Margin="12,0,0,4"/>
                <TextBlock Grid.Column="3" Classes="form-label" Text="COMPRESSION" Margin="12,0,0,4"/>

                <!-- Row 1: Inputs -->
                <TextBox Grid.Row="1" Grid.Column="0"
                         Text="{Binding FormName}"
                         Watermark="Job name"/>
                <TextBox Grid.Row="1" Grid.Column="1"
                         Text="{Binding FormSourcePaths}"
                         Watermark="C:\path1;C:\path2"
                         Margin="12,0,0,0"/>
                <TextBox Grid.Row="1" Grid.Column="2"
                         Text="{Binding FormDestination}"
                         Watermark="C:\backups"
                         Margin="12,0,0,0"/>
                <ComboBox Grid.Row="1" Grid.Column="3"
                          ItemsSource="{x:Static vm:BackupViewModel.AllLevels}"
                          SelectedItem="{Binding FormCompression}"
                          Margin="12,0,0,0"
                          HorizontalAlignment="Stretch"/>

                <!-- Row 2: Action buttons -->
                <StackPanel Grid.Row="2" Grid.Column="4"
                            Orientation="Horizontal"
                            Spacing="8"
                            VerticalAlignment="Center"
                            Margin="12,10,0,0">
                    <Button Content="Cancel"
                            Command="{Binding CancelAddCommand}"
                            Padding="14,6"/>
                    <Button Content="Save"
                            Command="{Binding SaveJobCommand}"
                            Theme="{StaticResource PrimaryButton}"
                            Padding="14,6"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Jobs DataGrid -->
        <DataGrid ItemsSource="{Binding Jobs}"
                  AutoGenerateColumns="False"
                  CanUserReorderColumns="False"
                  CanUserResizeColumns="True"
                  CanUserSortColumns="True"
                  x:CompileBindings="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Name"        Binding="{Binding Name}"                                              Width="140" IsReadOnly="True"/>
                <DataGridTextColumn Header="Sources"     Binding="{Binding SourcePaths.Count}"                                 Width="80"  IsReadOnly="True"/>
                <DataGridTextColumn Header="Destination" Binding="{Binding DestinationPath}"                                   Width="200" IsReadOnly="True"/>
                <DataGridTextColumn Header="Compression" Binding="{Binding Compression}"                                       Width="110" IsReadOnly="True"/>
                <DataGridTextColumn Header="Last Run"    Binding="{Binding LastRun, StringFormat=\{0:yyyy-MM-dd HH:mm\}}"     Width="130" IsReadOnly="True"/>
                <DataGridTemplateColumn Header="" Width="*" IsReadOnly="True">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="models:BackupJob">
                            <StackPanel Orientation="Horizontal" Spacing="6" Margin="4,2">
                                <Button Content="Run"
                                        Theme="{StaticResource PrimaryButton}"
                                        Command="{Binding $parent[UserControl].((vm:BackupViewModel)DataContext).RunJobCommand}"
                                        CommandParameter="{Binding}"
                                        Padding="10,4" FontSize="11"/>
                                <Button Content="Edit"
                                        Command="{Binding $parent[UserControl].((vm:BackupViewModel)DataContext).EditJobCommand}"
                                        CommandParameter="{Binding}"
                                        Padding="10,4" FontSize="11"/>
                                <Button Content="Delete"
                                        Theme="{StaticResource DangerButton}"
                                        Command="{Binding $parent[UserControl].((vm:BackupViewModel)DataContext).DeleteJobCommand}"
                                        CommandParameter="{Binding}"
                                        Padding="10,4" FontSize="11"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

    </DockPanel>
</UserControl>
