<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="CraftConsole.App"
             xmlns:local="using:CraftConsole"
             xmlns:converters="using:CraftConsole.Converters"
             RequestedThemeVariant="Dark">

    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://CraftConsole/Themes/CraftConsoleTheme.axaml"/>
            </ResourceDictionary.MergedDictionaries>
            <converters:LevelToColorConverter     x:Key="LevelToColorConverter"/>
            <converters:UsernameToColorConverter   x:Key="UsernameToColorConverter"/>
            <converters:IssueTypeToBgConverter     x:Key="IssueTypeToBgConverter"/>
            <converters:IssueTypeToFgConverter     x:Key="IssueTypeToFgConverter"/>
            <converters:StringToBrushConverter     x:Key="StringToBrushConverter"/>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml"/>

        <!-- Global defaults -->
        <Style Selector="Window, UserControl">
            <Setter Property="FontFamily" Value="Inter,Segoe UI,sans-serif"/>
        </Style>
        <Style Selector="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="FontFamily"  Value="Inter,Segoe UI,sans-serif"/>
        </Style>

        <!-- TextBox — dark themed, no template override -->
        <Style Selector="TextBox">
            <Setter Property="Background"      Value="{StaticResource SurfaceAltBrush}"/>
            <Setter Property="BorderBrush"     Value="{StaticResource SurfaceBorderBrush}"/>
            <Setter Property="Foreground"      Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="CaretBrush"      Value="{StaticResource AccentBrush}"/>
            <Setter Property="CornerRadius"    Value="{StaticResource InputRadius}"/>
            <Setter Property="Padding"         Value="12,9"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize"        Value="13"/>
        </Style>

        <!-- ListBox — remove Fluent defaults -->
        <Style Selector="ListBox">
            <Setter Property="Background"       Value="Transparent"/>
            <Setter Property="BorderThickness"  Value="0"/>
            <Setter Property="Padding"          Value="0"/>
        </Style>
        <Style Selector="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin"  Value="0"/>
        </Style>
        <!-- Strip Fluent's blue focus/selection from ListBoxItem content -->
        <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <!-- ProgressBar — clean dark track -->
        <Style Selector="ProgressBar">
            <Setter Property="Background"   Value="{StaticResource SurfaceAltBrush}"/>
            <Setter Property="Foreground"   Value="{StaticResource AccentBrush}"/>
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="MinHeight"    Value="0"/>
        </Style>
    </Application.Styles>
</Application>
