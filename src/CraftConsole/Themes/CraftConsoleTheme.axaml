<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================================
         MINEUI DESIGN SYSTEM — Ambient Weather / HMI navy-cyan theme
    ============================================================ -->

    <!-- Backgrounds -->
    <SolidColorBrush x:Key="BgBrush"              Color="#080D14"/>
    <SolidColorBrush x:Key="SurfaceBrush"         Color="#0F1824"/>
    <SolidColorBrush x:Key="SurfaceAltBrush"      Color="#162035"/>
    <SolidColorBrush x:Key="SurfaceBorderBrush"   Color="#1E2D45"/>
    <SolidColorBrush x:Key="TabBarBrush"          Color="#060A10"/>
    <SolidColorBrush x:Key="HeaderBrush"          Color="#060A10"/>
    <SolidColorBrush x:Key="SeparatorBrush"       Color="#14212F"/>

    <!-- Accent — cyan -->
    <SolidColorBrush x:Key="AccentBrush"          Color="#22D3EE"/>
    <SolidColorBrush x:Key="AccentDimBrush"       Color="#0C2D38"/>
    <SolidColorBrush x:Key="AccentHoverBrush"     Color="#67E8F9"/>

    <!-- Text -->
    <SolidColorBrush x:Key="TextPrimaryBrush"     Color="#F1F5F9"/>
    <SolidColorBrush x:Key="TextSecondaryBrush"   Color="#94A3B8"/>
    <SolidColorBrush x:Key="TextMutedBrush"       Color="#2D4160"/>

    <!-- Status -->
    <SolidColorBrush x:Key="DangerBrush"          Color="#F87171"/>
    <SolidColorBrush x:Key="DangerDimBrush"       Color="#2D1515"/>
    <SolidColorBrush x:Key="WarnBrush"            Color="#FB923C"/>
    <SolidColorBrush x:Key="WarnDimBrush"         Color="#2D1F0A"/>
    <SolidColorBrush x:Key="InfoBrush"            Color="#60A5FA"/>
    <SolidColorBrush x:Key="InfoDimBrush"         Color="#0F1E38"/>

    <!-- ============================================================
         SHADOWS & GLOWS
    ============================================================ -->
    <BoxShadows x:Key="CardShadow">0 4 24 0 #1A000000</BoxShadows>
    <BoxShadows x:Key="AccentGlow">0 0 18 3 #3022D3EE</BoxShadows>
    <BoxShadows x:Key="DangerGlow">0 0 14 2 #30F87171</BoxShadows>

    <!-- ============================================================
         CORNER RADII
    ============================================================ -->
    <CornerRadius x:Key="CardRadius">12</CornerRadius>
    <CornerRadius x:Key="PillRadius">8</CornerRadius>
    <CornerRadius x:Key="ChipRadius">20</CornerRadius>
    <CornerRadius x:Key="InputRadius">8</CornerRadius>

    <!-- ============================================================
         GLOBAL CONTROL STYLES
    ============================================================ -->

    <!-- Button — default secondary style -->
    <ControlTheme x:Key="{x:Type Button}" TargetType="Button">
        <Setter Property="Background"      Value="{StaticResource SurfaceAltBrush}"/>
        <Setter Property="Foreground"      Value="{StaticResource TextSecondaryBrush}"/>
        <Setter Property="BorderBrush"     Value="{StaticResource SurfaceBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius"    Value="{StaticResource PillRadius}"/>
        <Setter Property="Padding"         Value="14,7"/>
        <Setter Property="FontSize"        Value="12"/>
        <Setter Property="FontWeight"      Value="Medium"/>
        <Setter Property="Cursor"          Value="Hand"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Padding="{TemplateBinding Padding}">
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      HorizontalContentAlignment="Center"
                                      VerticalContentAlignment="Center"/>
                </Border>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover /template/ Border">
            <Setter Property="Background" Value="{StaticResource SurfaceBorderBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource TextMutedBrush}"/>
        </Style>
        <Style Selector="^:pressed /template/ Border">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
        </Style>
    </ControlTheme>

    <!-- Button.primary variant -->
    <ControlTheme x:Key="PrimaryButton" TargetType="Button"
                  BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background"  Value="{StaticResource AccentDimBrush}"/>
        <Setter Property="Foreground"  Value="{StaticResource AccentBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource AccentDimBrush}"/>
        <Style Selector="^:pointerover /template/ Border">
            <Setter Property="Background"  Value="{StaticResource AccentBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
            <Setter Property="BoxShadow"   Value="{StaticResource AccentGlow}"/>
        </Style>
        <Style Selector="^:pointerover /template/ ContentPresenter">
            <Setter Property="Foreground" Value="#080D14"/>
        </Style>
    </ControlTheme>

    <!-- Danger button variant -->
    <ControlTheme x:Key="DangerButton" TargetType="Button"
                  BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background"  Value="{StaticResource DangerDimBrush}"/>
        <Setter Property="Foreground"  Value="{StaticResource DangerBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource DangerDimBrush}"/>
    </ControlTheme>

    <!-- ScrollBar — thin and subtle -->
    <ControlTheme x:Key="{x:Type ScrollBar}" TargetType="ScrollBar">
        <Setter Property="Background"  Value="Transparent"/>
        <Setter Property="Width"       Value="4"/>
        <Setter Property="Opacity"     Value="0.4"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Grid>
                    <Track x:Name="PART_Track" IsDirectionReversed="True">
                        <Track.DecreaseButton>
                            <RepeatButton x:Name="PART_LineUpButton" Classes="line" IsVisible="False"/>
                        </Track.DecreaseButton>
                        <Track.IncreaseButton>
                            <RepeatButton x:Name="PART_LineDownButton" Classes="line" IsVisible="False"/>
                        </Track.IncreaseButton>
                        <Thumb x:Name="thumb"
                               Background="{StaticResource TextMutedBrush}"
                               Width="4" MinHeight="24"
                               CornerRadius="2"/>
                    </Track>
                </Grid>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover">
            <Setter Property="Opacity" Value="0.8"/>
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.15"/>
                </Transitions>
            </Setter>
        </Style>
    </ControlTheme>

    <!-- ============================================================
         GLASS CARD — elevated variant for key metrics
         Gradient bg + cyan top accent border + ambient glow
    ============================================================ -->
    <ControlTheme x:Key="GlassCard" TargetType="Border">
        <Setter Property="Background">
            <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                <GradientStop Color="#141F30" Offset="0"/>
                <GradientStop Color="#0F1824" Offset="1"/>
            </LinearGradientBrush>
        </Setter>
        <Setter Property="BorderBrush"     Value="{StaticResource AccentDimBrush}"/>
        <Setter Property="BorderThickness" Value="0,2,0,0"/>
        <Setter Property="CornerRadius"    Value="{StaticResource CardRadius}"/>
        <Setter Property="BoxShadow"       Value="{StaticResource AccentGlow}"/>
        <Setter Property="Padding"         Value="20"/>
    </ControlTheme>

</ResourceDictionary>
