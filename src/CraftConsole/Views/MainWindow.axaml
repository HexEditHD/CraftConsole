<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:CraftConsole.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        x:Class="CraftConsole.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="CraftConsole"
        Width="1280" Height="800"
        MinWidth="960" MinHeight="640"
        Background="{StaticResource BgBrush}">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <!-- Tab text colour via Window.Styles (descendant selectors not allowed in ControlTheme) -->
    <Window.Styles>
        <Style Selector="ListBoxItem TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
            <Setter Property="FontFamily"  Value="Inter,Segoe UI,sans-serif"/>
        </Style>
        <Style Selector="ListBoxItem:selected TextBlock">
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
        </Style>
        <Style Selector="ListBoxItem:pointerover TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="48,*,64">

        <!-- ═══════════════════════════════════════════════
             ROW 0 — App header
        ═══════════════════════════════════════════════ -->
        <Border Grid.Row="0"
                Background="{StaticResource HeaderBrush}"
                BorderThickness="0,0,0,1"
                Padding="20,0">
            <Border.BorderBrush>
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                    <GradientStop Color="#0014212F" Offset="0"/>
                    <GradientStop Color="#9922D3EE" Offset="0.5"/>
                    <GradientStop Color="#0014212F" Offset="1"/>
                </LinearGradientBrush>
            </Border.BorderBrush>
            <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Stretch">

                <!-- Brand mark -->
                <StackPanel Grid.Column="0" Orientation="Horizontal"
                            Spacing="10" VerticalAlignment="Center">
                    <Border Width="26" Height="26"
                            CornerRadius="7"
                            Background="{StaticResource AccentDimBrush}">
                        <TextBlock Text="M"
                                   FontSize="13" FontWeight="Bold"
                                   Foreground="{StaticResource AccentBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="CraftConsole"
                               FontSize="14" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Server status chip (header) -->
                <Border Grid.Column="2"
                        CornerRadius="{StaticResource ChipRadius}"
                        Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource SurfaceBorderBrush}"
                        BorderThickness="1"
                        Padding="12,5"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <Ellipse x:Name="StatusDot"
                                 Width="6" Height="6"
                                 Fill="{Binding ServerRunning, Converter={StaticResource BoolToStatusBrushConverter}}"
                                 VerticalAlignment="Center">
                            <Ellipse.Styles>
                                <Style Selector="Ellipse#StatusDot">
                                    <Style.Animations>
                                        <Animation Duration="0:0:1.8"
                                                   IterationCount="Infinite"
                                                   PlaybackDirection="Alternate"
                                                   Easing="SineEaseInOut">
                                            <KeyFrame Cue="0%">
                                                <Setter Property="Opacity" Value="1"/>
                                            </KeyFrame>
                                            <KeyFrame Cue="100%">
                                                <Setter Property="Opacity" Value="0.25"/>
                                            </KeyFrame>
                                        </Animation>
                                    </Style.Animations>
                                </Style>
                            </Ellipse.Styles>
                        </Ellipse>
                        <TextBlock Text="{Binding ServerStatusLabel}"
                                   FontSize="11" FontWeight="Medium"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

            </Grid>
        </Border>

        <!-- ═══════════════════════════════════════════════
             ROW 1 — Page content
        ═══════════════════════════════════════════════ -->
        <Border Grid.Row="1"
                Background="{StaticResource BgBrush}"
                Padding="28,24,28,20">
            <TransitioningContentControl Content="{Binding CurrentPage}">
                <TransitioningContentControl.PageTransition>
                    <CrossFade Duration="0:0:0.15"/>
                </TransitioningContentControl.PageTransition>
            </TransitioningContentControl>
        </Border>

        <!-- ═══════════════════════════════════════════════
             ROW 2 — Bottom navigation
        ═══════════════════════════════════════════════ -->
        <Border Grid.Row="2"
                Background="{StaticResource TabBarBrush}"
                BorderThickness="0,1,0,0">
            <Border.BorderBrush>
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                    <GradientStop Color="#0014212F" Offset="0"/>
                    <GradientStop Color="#9922D3EE" Offset="0.5"/>
                    <GradientStop Color="#0014212F" Offset="1"/>
                </LinearGradientBrush>
            </Border.BorderBrush>

            <ListBox ItemsSource="{Binding NavItems}"
                     SelectedItem="{Binding SelectedNavItem}"
                     Background="Transparent"
                     Padding="8,0">

                <ListBox.ItemContainerTheme>
                    <ControlTheme TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin"  Value="2,0"/>
                        <Setter Property="Cursor"  Value="Hand"/>
                        <Setter Property="Template">
                            <ControlTemplate>
                                <!-- Stack: top accent line + content pill -->
                                <Grid RowDefinitions="2,*">
                                    <!-- Active indicator line (fades in/out) -->
                                    <Border x:Name="ActiveLine"
                                            Grid.Row="0"
                                            Background="{StaticResource AccentBrush}"
                                            CornerRadius="0,0,2,2"
                                            Opacity="0"
                                            BoxShadow="0 3 12 1 #4022D3EE">
                                        <Border.Transitions>
                                            <Transitions>
                                                <DoubleTransition Property="Opacity" Duration="0:0:0.18"/>
                                            </Transitions>
                                        </Border.Transitions>
                                    </Border>
                                    <!-- Content area -->
                                    <Border x:Name="Pill"
                                            Grid.Row="1"
                                            Background="Transparent"
                                            CornerRadius="{StaticResource PillRadius}"
                                            Padding="10,7,10,6">
                                        <ContentPresenter Content="{TemplateBinding Content}"
                                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                                          HorizontalContentAlignment="Center"
                                                          VerticalContentAlignment="Center"/>
                                    </Border>
                                </Grid>
                            </ControlTemplate>
                        </Setter>
                        <!-- Selected: show accent line -->
                        <Style Selector="^:selected /template/ Border#ActiveLine">
                            <Setter Property="Opacity" Value="1"/>
                        </Style>
                        <!-- Hover: subtle pill tint -->
                        <Style Selector="^:pointerover /template/ Border#Pill">
                            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
                        </Style>
                    </ControlTheme>
                </ListBox.ItemContainerTheme>

                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="1"/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>

                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:NavItem">
                        <StackPanel Spacing="2" HorizontalAlignment="Center">
                            <TextBlock Text="{Binding Icon}"
                                       FontSize="15"
                                       FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Label}"
                                       FontSize="9"
                                       FontWeight="Medium"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>

            </ListBox>
        </Border>

    </Grid>
</Window>
