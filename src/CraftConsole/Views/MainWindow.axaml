<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:CraftConsole.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        x:Class="CraftConsole.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="CraftConsole"
        Width="1280" Height="800"
        MinWidth="960" MinHeight="640"
        Background="{StaticResource BgBrush}">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <!-- Tab text colour via Window.Styles (descendant selectors not allowed in ControlTheme) -->
    <Window.Styles>
        <Style Selector="ListBoxItem TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
            <Setter Property="FontFamily"  Value="Inter,Segoe UI,sans-serif"/>
        </Style>
        <Style Selector="ListBoxItem:selected TextBlock">
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
        </Style>
        <Style Selector="ListBoxItem:pointerover TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="48,*,64">

        <!-- ═══════════════════════════════════════════════
             ROW 0 — App header
        ═══════════════════════════════════════════════ -->
        <Border Grid.Row="0"
                Background="{StaticResource HeaderBrush}"
                BorderBrush="{StaticResource SeparatorBrush}"
                BorderThickness="0,0,0,1"
                Padding="20,0">
            <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Stretch">

                <!-- Brand mark -->
                <StackPanel Grid.Column="0" Orientation="Horizontal"
                            Spacing="10" VerticalAlignment="Center">
                    <Border Width="26" Height="26"
                            CornerRadius="7"
                            Background="{StaticResource AccentDimBrush}">
                        <TextBlock Text="M"
                                   FontSize="13" FontWeight="Bold"
                                   Foreground="{StaticResource AccentBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="CraftConsole"
                               FontSize="14" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Server status chip (header) -->
                <Border Grid.Column="2"
                        CornerRadius="{StaticResource ChipRadius}"
                        Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource SurfaceBorderBrush}"
                        BorderThickness="1"
                        Padding="12,5"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <Ellipse Width="6" Height="6"
                                 Fill="{StaticResource TextMutedBrush}"
                                 VerticalAlignment="Center"/>
                        <TextBlock Text="No server"
                                   FontSize="11" FontWeight="Medium"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

            </Grid>
        </Border>

        <!-- ═══════════════════════════════════════════════
             ROW 1 — Page content
        ═══════════════════════════════════════════════ -->
        <Border Grid.Row="1"
                Background="{StaticResource BgBrush}"
                Padding="28,24,28,20">
            <TransitioningContentControl Content="{Binding CurrentPage}"/>
        </Border>

        <!-- ═══════════════════════════════════════════════
             ROW 2 — Bottom navigation
        ═══════════════════════════════════════════════ -->
        <Border Grid.Row="2"
                Background="{StaticResource TabBarBrush}"
                BorderBrush="{StaticResource SeparatorBrush}"
                BorderThickness="0,1,0,0">
            <ListBox ItemsSource="{Binding NavItems}"
                     SelectedItem="{Binding SelectedNavItem}"
                     Background="Transparent"
                     Padding="8,0">

                <ListBox.ItemContainerTheme>
                    <ControlTheme TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin"  Value="2,8"/>
                        <Setter Property="Cursor"  Value="Hand"/>
                        <Setter Property="Template">
                            <ControlTemplate>
                                <!-- Pill container -->
                                <Border x:Name="Pill"
                                        Background="Transparent"
                                        CornerRadius="{StaticResource PillRadius}"
                                        Padding="10,6">
                                    <ContentPresenter Content="{TemplateBinding Content}"
                                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                                      HorizontalContentAlignment="Center"
                                                      VerticalContentAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Setter>
                        <!-- Selected: dim green pill -->
                        <Style Selector="^:selected /template/ Border#Pill">
                            <Setter Property="Background" Value="{StaticResource AccentDimBrush}"/>
                        </Style>
                        <!-- Hover: subtle surface tint -->
                        <Style Selector="^:pointerover /template/ Border#Pill">
                            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
                        </Style>
                    </ControlTheme>
                </ListBox.ItemContainerTheme>

                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="1"/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>

                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:NavItem">
                        <TextBlock Text="{Binding Label}"
                                   FontSize="11"
                                   FontWeight="Medium"
                                   HorizontalAlignment="Center"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>

            </ListBox>
        </Border>

    </Grid>
</Window>
