<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="CraftConsole.Views.ReasonDialog"
        Title="Enter Reason"
        Width="420" Height="180"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource SurfaceBrush}"
        ShowInTaskbar="False">

    <Grid RowDefinitions="Auto,*,Auto" Margin="24,20,24,20">

        <!-- Prompt -->
        <TextBlock x:Name="PromptLabel"
                   Grid.Row="0"
                   FontSize="13"
                   Foreground="{StaticResource TextPrimaryBrush}"
                   Margin="0,0,0,12"/>

        <!-- Input -->
        <TextBox x:Name="ReasonBox"
                 Grid.Row="1"
                 Watermark="Enter reason (optional)…"
                 VerticalAlignment="Top"/>

        <!-- Buttons -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="8"
                    Margin="0,16,0,0">
            <Button Content="Cancel"
                    Click="OnCancel"
                    Padding="18,8"/>
            <Button Content="OK"
                    Click="OnOk"
                    Theme="{StaticResource PrimaryButton}"
                    Padding="24,8"/>
        </StackPanel>

    </Grid>
</Window>
